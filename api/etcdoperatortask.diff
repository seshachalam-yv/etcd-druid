+func (r *Reconciler) updateTaskStatus(ctx context.Context, log logr.Logger, task *druidv1alpha1.EtcdOperatorTask) error {
+	// This is where you persist changes made to task.Status
+	if task.Status.ObservedGeneration == nil || *task.Status.ObservedGeneration != task.Generation {
